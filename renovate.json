{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": [
    "ulfiac"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "depNameTemplate": "opentofu/opentofu",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "managerFilePatterns": [
        "opentofu/.opentofu-version"
      ],
      "matchStrings": [
        "^(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "depNameTemplate": "terraform-linters/tflint",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "managerFilePatterns": [
        "tflint/.tflint-version"
      ],
      "matchStrings": [
        "^(?<currentValue>\\S+)"
      ]
    }
  ],
  "extends": [
    "config:recommended",
    "mergeConfidence:all-badges"
  ],
  "labels": [
    "renovate"
  ],
  "packageRules": [
    {
      "groupName": "Monday packages",
      "matchPackageNames": [
        "actions/checkout",
        "alpine",
        "aquasecurity/trivy-action",
        "debian",
        "docker/build-push-action",
        "docker/login-action",
        "gruntwork-io/terragrunt",
        "hashicorp/archive",
        "hashicorp/aws",
        "hashicorp/local",
        "hashicorp/random",
        "hashicorp/terraform",
        "hadolint/hadolint-action",
        "integrations/github",
        "opentofu/opentofu",
        "terraform-linters/tflint"
      ],
      "minimumReleaseAge": "7 days",
      "reviewers": [
        "ulfiac"
      ],
      "schedule": [
        "before 9am on monday"
      ]
    },
    {
      "groupName": "commons packages",
      "matchPackageNames": [
        "ulfiac/commons"
      ]
    }
  ],
  "prHourlyLimit": 5,
  "timezone": "America/New_York"
}
